{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.SemanticKernel": "Information",
      "System.Net.Http.HttpClient.GeminiJsonClient": "None"
    }
  },
  "AllowedHosts": "*",
  "SemanticKernel": {
    "FastLLM": {
      "ServiceId": "fast-llm",
      "Model": "llama-3.1-8b-instant",
      "Endpoint": "https://api.groq.com/openai/v1",
      "Description": "Small/Fast LLM for routing and intent classification"
    },
    "SmartLLM": {
      "ServiceId": "smart-llm",
      "Model": "llama-3.3-70b-versatile",
      "Endpoint": "https://api.groq.com/openai/v1",
      "Description": "Large/Smart LLM for SQL generation and analysis"
    }
  },
  "Chat": {
    "SessionTTLMinutes": 30,
    "MaxHistoryMessages": 20
  },
  "InsightRefresh": {
    "Enabled": true,
    "RefreshIntervalMinutes": 30,
    "InitialDelayMinutes": 2,
    "BatchSize": 10,
    "DelayBetweenBusinessesMs": 500,
    "DelayBetweenBatchesMs": 2000
  },
  "APP": {
    "GEMINI": {
      "API_KEY": "${GEMINI_API_KEY}",
      "MODEL": "gemini-3-flash-preview"
    },
    "GROQ": {
      "API_KEY": "${GROQ_API_KEY}",
      "MODEL_CHAT": "groq/compound/mini",
      "MODEL_REPORT": "groq/compound"
    }
  }
}
